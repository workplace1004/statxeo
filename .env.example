# ─────────────────────────────────────────────
# Statxeo Web Platform — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git (it is already in .gitignore).
# ─────────────────────────────────────────────

# ── Auth ──────────────────────────────────────
# Required. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# ── Site ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://statxeo.com

# ── MongoDB ───────────────────────────────────
# Required. Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ── StatXT API ────────────────────────────────
# Required. Base URL of the statxt.com proxy backend.
STATXT_API_BASE_URL=https://statxt.com

# ── AI Providers ──────────────────────────────
OPENAI_API_KEY=

# ── Stripe ────────────────────────────────────
# Use test keys locally (pk_test_ / sk_test_). Never use sk_live_ in dev.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Connect webhook secrets (obtain from Stripe dashboard)
CONNECT_WEBHOOK_SECRET_THIN=whsec_...
CONNECT_WEBHOOK_SECRET_SNAPSHOT=whsec_...
SIGNING_SECRET_WHITE_LABEL_SNAPSHOT=whsec_...
SIGNING_SECRET_WHITE_LABEL_THIN=whsec_...

# ── Outstand ──────────────────────────────────
# Optional. Used by site-projects service for external API calls.
OUSTAND_API_KEY=ost_...

# ── ReactBits License ─────────────────────────
REACTBITS_LICENSE_KEY=

# ── Google Ads API ────────────────────────────
# NOTE: White-labeler and client ad campaigns route through Outstand (outstand.so),
# which manages OAuth connections per business owner — no raw tokens needed per client.
# These vars are only for PLATFORM-LEVEL admin campaigns if we ever run our own ads directly.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_OAUTH_TOKEN=

# ── Meta (Facebook) Ads API ───────────────────
# NOTE: Same as above — white-labeler Meta campaigns go through Outstand.
# Business owners connect their Facebook/Instagram via the Outstand OAuth flow.
# The outstandAccountId is stored per org in whiteLabelerSocialAccounts collection.
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# META_PAGE_ID=

# ── Supabase (LEGACY — do not use in new code) ─
# These keys remain here only for reference. No production /src code reads them.
# SUPABASE_PROJECT_REF=
# SUPABASE_REGION=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
